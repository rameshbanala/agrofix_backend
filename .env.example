# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Set to "true" once you've verified your DB provider's certificate chain
# validates — leaving it unset preserves the previous permissive behavior.
DB_SSL_REJECT_UNAUTHORIZED=false

# Auth
JWT_SECRET=
TOKEN_EXPIRY=1d

# Frontend URL(s), used for password-reset links and CORS.
# ALLOWED_ORIGINS accepts a comma-separated list; defaults to CLIENT_URL.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Email (Gmail SMTP) — used for password reset emails
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=AgroFix
